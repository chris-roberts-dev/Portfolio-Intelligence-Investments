# Local-development example only. Copy to .env and replace placeholder values.
# Never commit real credentials or production secrets.

POSTGRES_DB=portfolio_intelligence
POSTGRES_USER=portfolio_intelligence
POSTGRES_PASSWORD=change-me-local-postgres-password

DJANGO_SECRET_KEY=change-me-local-django-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DEBUG=true

# Credential-free development default. Provider selection remains server-side.
MARKET_DATA_DEFAULT_PROVIDER=yfinance
MARKET_DATA_ALLOWED_PROVIDERS=yfinance,mock,csv
